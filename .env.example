# Copy to .env and fill in your model and API key.
LLM_MODEL=
LLM_API_KEY=

# Required for this example: use your provider's API base URL, without /chat/completions.
LLM_BASE_URL=https://api.example.com/v1
LLM_TIMEOUT=30

# P1: maximum number of model requests per task (1-100).
AGENT_MAX_STEPS=5

# P2: maximum plan steps and invalid-plan repairs.
PLAN_MAX_STEPS=5
PLAN_MAX_REPAIRS=1

# P3: maximum answer revisions (0-2), each followed by another check.
REFLECTION_MAX_REVISIONS=1

# P4: maximum model requests within the calculator role.
COOP_WORKER_MAX_STEPS=5
